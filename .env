# Фронт (Vite): yarn dev → обычно http://localhost:3000
#
# API: либо прямой URL бэкенда (другой порт, не как у Vite!), либо пусто + proxy ниже.
# Прямой вызов API (без proxy):
# VITE_MAIN_SERVICE_URL=http://localhost:5202
#
# Через proxy Vite (запросы на тот же :3000 → пересылаются на 5202):
VITE_MAIN_SERVICE_URL=
VITE_DEV_REDIRRECT_MAIN_SERVICE_URL=http://localhost:5202
